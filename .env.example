# Copy this file to .env and fill in the values yourself. .env is git-ignored: never commit keys.

# Google AI Studio (Gemini's free tier): writes the explanations, and later runs the development
# LLM baseline. Free-tier prompts may be used by Google, so only public data goes into them.
# Without it, explanations fall back to plain sentences built from the same facts.
GEMINI_API_KEY=

# Anthropic API: the final LLM baseline, later. Use a key with a small prepaid credit and a
# monthly spending limit.
ANTHROPIC_API_KEY=

# Optional: keep datasets somewhere other than ./data
# NEXTCOUR_DATA_DIR=
