# Copy this file to .env and fill in the values yourself. .env is git-ignored: never commit keys.

# Anthropic API: the explanation writer (roadmap Phase 1) and the final LLM baseline (Phase 5).
# Use a key with a small prepaid credit and a monthly spending limit.
ANTHROPIC_API_KEY=

# Google AI Studio (Gemini's free tier): the development LLM baseline (roadmap Phase 2).
# Free-tier prompts may be used by Google, so only public data goes into them.
GEMINI_API_KEY=

# Optional: keep datasets somewhere other than ./data
# NEXTCOUR_DATA_DIR=
